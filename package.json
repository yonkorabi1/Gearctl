{
  "name": "@onu-platform/olt-cli-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Stateless SSH/Telnet CLI executor for OLT devices — generic, vendor-agnostic core with a NAPALM-style driver seam. Holds no state; platform-api is the sole orchestrator (credentials, run history, audit).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "test": "jest",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "ssh2": "^1.15.0",
    "zod": "^3.23.8",
    "pino": "^9.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/ssh2": "^1.15.0",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
